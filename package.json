{
  "name": "sierrendipity",
  "version": "0.1.0",
  "private": true,
  "description": "A web-based coding tutor for Python, C and C++",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthusAI/Sierrendipity.git"
  },
  "workspaces": [
    "infra",
    "api",
    "runner",
    "web"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "cucumber-js",
